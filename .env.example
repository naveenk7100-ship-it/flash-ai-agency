# Flash.ai Agency Environment Variables Configuration

# -----------------------------------------------------------------------------
# 1. SECURITY & ADMIN ACCESS (MANDATORY)
# -----------------------------------------------------------------------------
# Admin username and credentials for /admin and /admin/leads
ADMIN_USERNAME=admin
# Initial password for first login (e.g. NAVEEN@20). System requires password update on first login.
ADMIN_INITIAL_PASSWORD=
# Or provide precomputed PBKDF2 hash generated with: node scripts/setup_admin.js
ADMIN_PASSWORD_HASH=
# Random cryptographic secret used to sign admin session cookies
ADMIN_SESSION_SECRET=
ADMIN_SECRET_KEY=

# -----------------------------------------------------------------------------
# 2. PERSISTENCE & DATABASE (NEON POSTGRESQL - RECOMMENDED)
# -----------------------------------------------------------------------------
# Neon Serverless PostgreSQL connection string (Direct or Pooled)
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Alternative alias: POSTGRES_URL (Vercel Postgres integration)
# POSTGRES_URL=postgresql://...

# Optional fallback: Upstash Redis REST API
UPSTASH_REDIS_REST_URL=https://xxxx-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxx=

# -----------------------------------------------------------------------------
# 3. NOTIFICATION PROVIDERS (OPTIONAL - SAFE DEGRADATION IF OMITTED)
# -----------------------------------------------------------------------------
# Resend API for transactional confirmation emails and agency notifications.
# Sign up at: https://resend.com (Free tier: 100 emails/day, 3,000/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
AGENCY_NOTIFICATION_EMAIL=flashai.digital@gmail.com

# Meta WhatsApp Cloud API for instant lead alerts to your phone.
# Configure via: https://developers.facebook.com
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_PHONE=

# -----------------------------------------------------------------------------
# 4. PUBLIC SITE SETTINGS (OPTIONAL)
# -----------------------------------------------------------------------------
# Physical office location (Shown on /contact only if explicitly configured)
# Leave blank for 100% remote agency presence.
NEXT_PUBLIC_BUSINESS_LOCATION=
